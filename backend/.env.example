# Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/luxury_hotel_booking

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_token_key_here_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_here_min_32_chars
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_EMAIL_VERIFY_SECRET=your_email_verify_secret_key_here
JWT_EMAIL_VERIFY_EXPIRE=24h
JWT_PASSWORD_RESET_EXPIRE=1h

# Client URL
FRONTEND_URL=http://localhost:5173

# Brand name used in email templates and subjects
BRAND_NAME=AureliaStay

# Email verification
# MANDATORY: login is rejected until the user verifies their email address.
# This cannot be disabled for security reasons.

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Redis
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=Luxury Hotel Booking
EMAIL_FROM_ADDRESS=noreply@luxuryhotel.com

# SMS Service (Fast2SMS / Twilio)
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=LXHOTEL

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Reverse Proxy trust hops (Render sits behind one trusted proxy → keep 1;
# raise only if more hops sit between the internet and the server)
TRUST_PROXY_HOPS=1

# Logging
LOG_LEVEL=debug
