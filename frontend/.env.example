# Backend API base URL (Vite replaces VITE_* vars at build time).
# When empty, the app falls back to the dev proxy: /api -> http://localhost:5000
VITE_API_URL=http://localhost:5000/api/v1

# Frontend origin (used for links/redirects and Razorpay checkouts).
VITE_FRONTEND_URL=http://localhost:5173

# Canonical site URL for SEO (robots/sitemap/canonical). When empty, sitemap.xml
# is not emitted and canonical URLs fall back to the current origin.
VITE_SITE_URL=

# Razorpay checkout public key (optional until payments are wired).
VITE_RAZORPAY_KEY_ID=rzp_test_TNOFokR6Gkm9KH
